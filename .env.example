# JSearch API key from RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
RAPIDAPI_KEY=

# Random secret string; also set this in Vercel's project env vars.
# Vercel automatically sends it as a Bearer token when invoking your cron job,
# which the /api/cron/fetch-jobs route checks for. Leave unset locally to skip
# the check during manual testing.
CRON_SECRET=

# Added automatically when you attach an Upstash Redis store to the project
# (Vercel dashboard -> Storage -> Marketplace Database Providers -> Upstash).
# No need to set these by hand once that's connected; listed here for local
# dev reference. Depending on integration version these may instead be named
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN — the app accepts either.
KV_REST_API_URL=
KV_REST_API_TOKEN=
